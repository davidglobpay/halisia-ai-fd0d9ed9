  "policies": [
    {
      "cmd": "ALL",
      "permissive": "PERMISSIVE",
      "policyname": "Applicant manages own financing applications",
      "qual": "(auth.uid() = applicant_id)",
      "roles": ["authenticated"],
      "with_check": "(auth.uid() = applicant_id)"
    },
    {
      "cmd": "ALL",
      "permissive": "RESTRICTIVE",
      "policyname": "halisia_active_account",
      "qual": "halisia_account_active()",
      "roles": ["authenticated"],
      "with_check": "halisia_account_active()"
    },
    {
      "cmd": "SELECT",
      "permissive": "PERMISSIVE",
      "policyname": "halisia_master_admin_read",
      "qual": "has_role(auth.uid(), 'administrator'::app_role)",
      "roles": ["authenticated"],
      "with_check": null
    }
  ],
  "triggers": [
    {
      "definition": "CREATE TRIGGER halisia_guard_financing_status BEFORE UPDATE ON public.financing_applications FOR EACH ROW EXECUTE FUNCTION halisia_private.guard_financing_status()"
    },
    {
      "definition": "CREATE TRIGGER halisia_reject_suspended_write BEFORE INSERT OR DELETE OR UPDATE ON public.financing_applications FOR EACH ROW EXECUTE FUNCTION halisia_private.reject_suspended_write()"
    },
    {
      "definition": "CREATE TRIGGER trg_financing_updated_at BEFORE UPDATE ON public.financing_applications FOR EACH ROW EXECUTE FUNCTION set_updated_at()"
    }
