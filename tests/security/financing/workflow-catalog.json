  "policies": [
    {
      "cmd": "ALL",
      "permissive": "PERMISSIVE",
      "policyname": "Provider manages own proposals",
      "qual": "(auth.uid() = provider_id)",
      "roles": ["authenticated"],
      "schemaname": "public",
      "tablename": "bid_proposals",
      "with_check": "(auth.uid() = provider_id)"
    },
    {
      "cmd": "SELECT",
      "permissive": "PERMISSIVE",
      "policyname": "Request owner can read proposals on their requests",
      "qual": "(EXISTS ( SELECT 1\n   FROM bid_requests r\n  WHERE ((r.id = bid_proposals.bid_request_id) AND (r.owner_id = auth.uid()))))",
      "roles": ["authenticated"],
      "schemaname": "public",
      "tablename": "bid_proposals",
      "with_check": null
    },
    {
      "cmd": "UPDATE",
      "permissive": "PERMISSIVE",
      "policyname": "Request owner can update proposal status",
      "qual": "(EXISTS ( SELECT 1\n   FROM bid_requests r\n  WHERE ((r.id = bid_proposals.bid_request_id) AND (r.owner_id = auth.uid()))))",
      "roles": ["authenticated"],
      "schemaname": "public",
      "tablename": "bid_proposals",
      "with_check": "(EXISTS ( SELECT 1\n   FROM bid_requests r\n  WHERE ((r.id = bid_proposals.bid_request_id) AND (r.owner_id = auth.uid()))))"
    },
