{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://nvcxhtdahzcpqijfxbsb.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "place-intelligence-hub",
      "version": "0.1.0",
      "title": "Place Intelligence Hub"
    },
    "tools": [
      {
        "name": "search_listings",
        "title": "Search marketplace listings",
        "description": "Search HALISIA marketplace listings visible to the signed-in user by county, text and max price. Listings are owner/source-listed, not title-verified.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "maxLength": 120,
              "description": "Text to match in the listing title."
            },
            "county": {
              "type": "string",
              "maxLength": 60,
              "description": "Kenyan county name, e.g. Kiambu."
            },
            "max_price": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Maximum asking price."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "default": 10
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_pulse_news",
        "title": "Get Pulse land news",
        "description": "List recent HALISIA Pulse land and property news, optionally filtered by county.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "county": {
              "type": "string",
              "maxLength": 60,
              "description": "Kenyan county name."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 8
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_saved_items",
        "title": "List my saved places",
        "description": "List the signed-in user's saved places, parcels and searches in HALISIA.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
